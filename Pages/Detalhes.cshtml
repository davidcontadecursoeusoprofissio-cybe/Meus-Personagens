



@page "{id:int}"
@model tccReladorioDeCriacao.Pages.DetalhesModel

@if (Model.Imaginario != null)
{
    <h1>@Model.Imaginario.Nome</h1>

    <h2>Imagem principal</h2>

    @if (!string.IsNullOrEmpty(Model.Imaginario.Imagem))
    {
        <img src="@Model.Imaginario.Imagem"
             alt="@Model.Imaginario.Nome"
             style="width:350px; height:350px; object-fit:cover;" />
    }

    <h2>Galeria de imagens</h2>

    <div>
        @foreach (var imagem in Model.Imaginario.Imagens)
        {
            <div style="display:inline-block; margin:10px;">

                <img src="@imagem.CaminhoImagem"
                     alt="Imagem de @Model.Imaginario.Nome"
                     style="width:180px; height:180px; object-fit:cover;" />

                <form method="post"
                      asp-page-handler="EditarImagem"
                      enctype="multipart/form-data">

                    <input type="hidden" name="ImagemId" value="@imagem.Id" />
                    <input type="file" name="NovaImagemGaleria" accept="image/*" required />

                    <button type="submit">Substituir imagem</button>
                </form>

                <form method="post" asp-page-handler="DeletarImagem">
                    <input type="hidden" name="ImagemId" value="@imagem.Id" />
                    <button type="submit">Apagar imagem</button>
                </form>

            </div>
        }
    </div>

    <hr />

    <h2>Adicionar imagens à galeria</h2>

    <form method="post"
          asp-page-handler="AdicionarImagens"
          enctype="multipart/form-data">

        <input type="file"
               asp-for="NovasImagens"
               accept="image/*"
               multiple />

        <button type="submit">Adicionar imagens</button>
    </form>

    <hr />

    <h2>Alterar imagem principal</h2>

    <form method="post"
          asp-page-handler="AtualizarImagemPrincipal"
          enctype="multipart/form-data">

        <input type="file"
               asp-for="NovaImagemPrincipal"
               accept="image/*" />

        <button type="submit">Alterar imagem principal</button>
    </form>

    <hr />

    <form method="post" asp-page-handler="EditarInformacoes">

        <input type="hidden" asp-for="Id" />

        <h2>Informações completas</h2>

        <h3>Identificação</h3>

        <p><strong>ID:</strong> @Model.Imaginario.Id</p>

        <label>Número:</label>
        <input asp-for="Imaginario.numero" />

        <br />

        <label>Nome:</label>
        <input asp-for="Imaginario.Nome" />

        <h3>Informações físicas</h3>

        <label>Altura:</label>
        <input asp-for="Imaginario.Altura" />

        <label>Idade:</label>
        <input asp-for="Imaginario.Idade" />

        <label>Ano:</label>
        <input asp-for="Imaginario.Ano" />

        <label>Inteligência:</label>
        <input asp-for="Imaginario.Inteligencia" />

        <label>Força:</label>
        <input asp-for="Imaginario.Força" />

        <label>Velocidade:</label>
        <input asp-for="Imaginario.Velocidade" />

        <label>Defesa:</label>
        <input asp-for="Imaginario.Defesa" />

        <label>Poder:</label>
        <input asp-for="Imaginario.Poder" />

        <h3>Localização</h3>

        <label>Local:</label>
        <input asp-for="Imaginario.Local" />

        <label>Descrição do local:</label>
        <textarea asp-for="Imaginario.DescricaoLocal"></textarea>

        <h3>História e contexto</h3>

        <label>Descrição:</label>
        <textarea asp-for="Imaginario.Descricao"></textarea>

        <label>Contexto histórico:</label>
        <input asp-for="Imaginario.ContextoHistorico" />

        <label>Descrição do contexto:</label>
        <textarea asp-for="Imaginario.DescricaContexto"></textarea>

        <h3>Ponto fraco e morte</h3>

        <label>Ponto fraco:</label>
        <input asp-for="Imaginario.PontoFraco" />

        <label>Descrição do ponto fraco:</label>
        <textarea asp-for="Imaginario.DescricaoPontoFraco"></textarea>

        <label>Morte:</label>
        <input asp-for="Imaginario.Morte" />

        <label>Descrição da morte:</label>
        <textarea asp-for="Imaginario.DescricaoMorte"></textarea>

        <h3>Características físicas detalhadas</h3>

        <label>Descrição dos pontos físicos:</label>
        <textarea asp-for="Imaginario.DescricaodosPontosFisicos"></textarea>

        <h3>Poderes</h3>

        <label>Poder de ataque:</label>
        <input asp-for="Imaginario.PoderdeAtaque" />

        <label>Poder de defesa:</label>
        <input asp-for="Imaginario.PoderdeDefesa" />

        <label>Poder de velocidade:</label>
        <input asp-for="Imaginario.PoderdeVelocidade" />

        <label>Tipo de poderes:</label>
        <input asp-for="Imaginario.TipodePoderes" />

        <label>Limitações dos poderes:</label>
        <textarea asp-for="Imaginario.LimitidosPoderes"></textarea>

        <label>Poder total:</label>
        <input asp-for="Imaginario.PoderTotal" />

        <label>Descrição dos poderes:</label>
        <textarea asp-for="Imaginario.DescricaodosPoderes"></textarea>

        <h3>Informações de criação</h3>

        <label>Nome do criador:</label>
        <input asp-for="Imaginario.NomedoCriador" />

        <label>Data de criação:</label>
        <input asp-for="Imaginario.DatadeCriacao" />

        <label>Mundo em que se passa:</label>
        <input asp-for="Imaginario.MundoemQuesePassar" />

        <br /><br />

        <button type="submit">Salvar todas as informações</button>

    </form>

    <hr />

    <a asp-page="/Index">Voltar à página principal</a>
}
else
{
    <h2>Imaginário não encontrado.</h2>
    <a asp-page="/Index">Voltar</a>
}